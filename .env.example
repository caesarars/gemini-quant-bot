# DeepSeek AI — required for AI analysis (get key at https://platform.deepseek.com)
DEEPSEEK_API_KEY="your_deepseek_api_key"

# Binance — leave empty to run in simulated/mock mode
BINANCE_API_KEY=""
BINANCE_SECRET_KEY=""

# PostgreSQL — used by docker-compose and the Express server
DB_HOST=db
DB_PORT=5432
DB_NAME=quantbot
DB_USER=quantbot
DB_PASSWORD=change_me_strong_password

# Telegram Notifications (get token from @BotFather, chat ID from @userinfobot)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# App URL (optional, for self-referential links)
APP_URL="http://localhost:3000"
